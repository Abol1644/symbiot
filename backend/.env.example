MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
# Prefer provider-specific variables. Do not commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
# For Ollama/vLLM or another OpenAI-compatible service:
# MODEL_PROVIDER=ollama
# MODEL_NAME=llama3.1
# BASE_URL=http://localhost:11434/v1
# Optional fallback chain, comma-separated provider:model entries.
FALLBACK_CHAIN=
# Keep this at or below the hard 30-minute ceiling.
RUN_TIMEOUT_MINUTES=30
# Set this only when using a managed vault key from an OS secret store.
SYMBIOT_VAULT_KEY=
